# Copy to .env and adjust. Every setting can also be passed as an environment variable.
DFD_ENVIRONMENT=dev
DFD_LOG_LEVEL=INFO
DFD_LOG_JSON=false

DFD_WEIGHTS_PATH=weights/xception_best.pth
DFD_DEVICE=auto
DFD_THRESHOLD=0.5
# Thresholds behind ?mode=... (JSON; calibrate from your ROC curve)
DFD_MODE_THRESHOLDS={"balanced": 0.45, "high_recall": 0.25, "high_precision": 0.8}
DFD_BATCH_SIZE=16
DFD_MAX_CONCURRENT_INFERENCES=2

DFD_MAX_UPLOAD_BYTES=10485760
DFD_MAX_BATCH_FILES=16

# Optional. When set, /api/* requires the header  X-API-Key: <value>
# DFD_API_KEY=change-me
# JSON list of allowed browser origins for CORS
# DFD_CORS_ORIGINS=["http://localhost:3000"]
